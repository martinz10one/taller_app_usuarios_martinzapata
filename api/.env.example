# Puerto de la API
PUERTO=3000

# Cadena de conexión a MongoDB (local o Atlas)
MONGODB_CNX=mongodb://127.0.0.1:27017/app-usuarios

# Secreto para firmar los JWT. Cámbialo en cualquier entorno compartido.
JWT_SECRET=este-es-un-secreto-largo-y-raro-para-firmar-tokens
JWT_EXPIRA=4h

# Administrador inicial: se crea al arrancar si no existe ningún administrador
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin123!
